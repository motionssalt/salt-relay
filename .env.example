# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_OWNER: GitHub user/organization owning the salt-relay repository.
GITHUB_OWNER="motionssalt"

# GITHUB_PAT: GitHub Personal Access Token for Actions and Release storage.
GITHUB_PAT="YOUR_GITHUB_PAT"

# CLOUDFLARE_API_TOKEN: Cloudflare API token with Workers, Pages, and D1 permissions.
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# CLOUDFLARE_D1_ID: Cloudflare D1 database ID for salt-relay-db.
CLOUDFLARE_D1_ID="29f8c89b-41cf-4b7e-906c-a475eb06febc"

# DASHBOARD_PASSWORD: Single-user dashboard authentication password.
DASHBOARD_PASSWORD="YOUR_DASHBOARD_PASSWORD"

# ENCRYPTION_KEY: Secret key for AES-256-GCM encryption of Zernio API keys at rest.
ENCRYPTION_KEY="YOUR_ENCRYPTION_KEY"

# CALLBACK_SECRET: Shared HMAC secret for GitHub Actions webhook verification.
CALLBACK_SECRET="YOUR_CALLBACK_SECRET"

# GOOGLE_DRIVE_API_KEY: Optional fallback API key for Google Drive public folder expansion.
GOOGLE_DRIVE_API_KEY=""
