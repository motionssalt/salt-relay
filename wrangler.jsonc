{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salt-relay-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salt-relay-db",
      "database_id": "29f8c89b-41cf-4b7e-906c-a475eb06febc"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
